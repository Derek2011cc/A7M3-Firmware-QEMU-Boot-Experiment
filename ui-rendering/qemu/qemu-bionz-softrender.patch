+/* --- software rasterizer for the observed 2D command lists --- */
+static bool cxd90045_sugi_exec_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        enabled = getenv("A7M3_SUGI_EXEC") != NULL;
+    }
+    return enabled;
+}
