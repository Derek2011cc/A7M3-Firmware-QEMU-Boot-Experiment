+/* --- local experiment: capture GPE command slots and 2D submissions --- */
+static uint32_t cxd90045_sugi_last_cmd;
+static unsigned int cxd90045_sugi_cmd_count;
+static unsigned int cxd90045_sugi_2d_count;
+
+static bool cxd90045_sugi_cmd_trace(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        enabled = getenv("A7M3_SUGI_CMDS") != NULL;
+    }
+    return enabled;
+}
+
+static bool cxd90045_sugi_addr_ok(hwaddr addr, unsigned int n)
+{
+    return (addr < 0x40000000ULL) ||
+           (addr >= 0x80000000ULL && addr + n <= 0x90000000ULL);
+}
+
+static void cxd90045_sugi_dump_words(const char *tag, unsigned int idx,
+                                     hwaddr addr, unsigned int words)
+{
+    uint32_t buf[1024];
+    unsigned int i;
+    if (!cxd90045_sugi_addr_ok(addr, words * 4)) {
+        return;
+    }
+    if (words > 1024) {
+        words = 1024;
+    }
+    cpu_physical_memory_read(addr, buf, words * 4);
+    fprintf(stderr, "%s[%u] addr=%08x:", tag, idx, (unsigned)addr);
+    for (i = 0; i < words; i++) {
+        fprintf(stderr, " %08x", buf[i]);
+    }
+    fprintf(stderr, "\n");
+}
+
+
+static void cxd90045_sugi_scan_cmd(unsigned int idx, uint32_t addr)
+{
+    uint32_t buf[16];
+    int i;
+    cxd90045_sugi_dump_words("SUGI-CMDX", idx, (hwaddr)addr, 32);
+    if (!cxd90045_sugi_addr_ok((hwaddr)addr, sizeof(buf))) {
+        return;
+    }
+    cpu_physical_memory_read((hwaddr)addr, buf, sizeof(buf));
+    for (i = 0; i + 1 < 16; i++) {
+        if ((buf[i] & 0xf000) == 0xf000 && (buf[i] >> 16) == 0x0116) {
+            uint32_t v = buf[i + 1];
+            cxd90045_sugi_dump_words("SUGI-116B", idx, (hwaddr)v, 32);
+            cxd90045_sugi_dump_words("SUGI-116W", idx,
+                                     (hwaddr)((uint64_t)v << 2), 32);
+            cxd90045_sugi_dump_words("SUGI-116U", idx,
+                                     (hwaddr)((uint64_t)v << 4), 32);
+            break;
+        }
+    }
+}
+
+static void cxd90045_sugi_scan_regs(unsigned int idx, uint32_t base)
+{
+    uint32_t buf[1024];
+    int i;
+    if (!cxd90045_sugi_addr_ok((hwaddr)base, sizeof(buf))) {
+        return;
+    }
+    cpu_physical_memory_read((hwaddr)base, buf, sizeof(buf));
+    for (i = 0; i + 1 < 1024; i++) {
+        uint32_t w = buf[i];
+        if (w >= 0x20000000u && w < 0x30000000u) {
+            cxd90045_sugi_dump_words("SUGI-PTR", idx, (hwaddr)w, 32);
+        }
+        if ((w & 0xffff) == 0xf000) {
+            uint32_t op = w >> 16;
+            uint32_t val = buf[i + 1];
+            if (op == 0x0589 && val) {
+                cxd90045_sugi_dump_words("SUGI-TEX", idx, (hwaddr)val, 64);
+            } else if (op == 0x0112 && val) {
+                cxd90045_sugi_dump_words("SUGI-DST", idx,
+                                         (hwaddr)((uint64_t)val << 4), 64);
+            } else if (op == 0x0116 && val) {
+                cxd90045_sugi_dump_words("SUGI-SRC", idx,
+                                         (hwaddr)((uint64_t)val << 4), 64);
+            }
+            i++;
+        }
+    }
+}
